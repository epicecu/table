PROJECT_NAME           = "Table owned-source documentation lint"
OUTPUT_DIRECTORY       = build/docs/lint
INPUT                  = src/table extras/nanopb/table/nanopb.h extras/nanopb/table/nanopb.c
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cpp
EXCLUDE_PATTERNS       = *.pb.h *.pb.c
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR           = FAIL_ON_WARNINGS
GENERATE_HTML           = NO
GENERATE_LATEX          = NO
GENERATE_XML            = YES
HAVE_DOT                = NO
QUIET                   = YES
